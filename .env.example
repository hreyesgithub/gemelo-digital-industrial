# Supabase opcional. Déjalas vacías para ejecutar sin persistencia.
SUPABASE_URL=
SUPABASE_KEY=

# Intervalo de simulación y frecuencia de persistencia.
TICK_SECONDS=1.0
PERSIST_EVERY=5

# Orígenes del dashboard desplegado en otra instancia.
# En producción, reemplaza * por dominios concretos separados por comas.
ALLOWED_ORIGINS=*
